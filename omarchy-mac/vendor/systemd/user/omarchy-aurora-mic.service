[Unit]
Description=Reconcile the Aurora microphone stereo mapping
After=pipewire.service pipewire-pulse.service wireplumber.service
PartOf=graphical-session.target
Wants=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
ExecCondition=/usr/bin/omarchy-hw-apple-silicon
ExecStart=/usr/bin/omarchy-audio-aurora-mic-map --watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
